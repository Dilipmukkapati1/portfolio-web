# Simple auth (defaults shown — override in .env.local)
AUTH_USERNAME=admin
AUTH_PASSWORD=portfolio
AUTH_DISPLAY_NAME=Admin
AUTH_SECRET=portfolio-dev-secret

# API target is chosen by npm script (overrides any NEXT_PUBLIC_* below):
#   npm run dev        → Azure dev Function App (default)
#   npm run dev:local  → portfolio-api on localhost:7071
#
# Optional: copy env/azure-dev.env.example or env/local.env.example to .env.local
# for auth only — do not set NEXT_PUBLIC_API_URL there unless you know you need to.

NEXT_PUBLIC_APP_URL=http://localhost:3000
